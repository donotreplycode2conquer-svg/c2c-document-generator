# Code2Conquer Document Generator - Backend Environment Configuration (Render Web Service)

# Server Port (Render dynamically assigns PORT, default fallback is 5000)
PORT=5000

# MongoDB Atlas Connection String (Must be set in Render Environment Variables)
# Example: mongodb+srv://<username>:<password>@code2conquer.64b9cdm.mongodb.net/code2conquer?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://donotreplycode2conquer_db_user:<YOUR_PASSWORD>@code2conquer.64b9cdm.mongodb.net/code2conquer?retryWrites=true&w=majority

# JWT Secret Key for Administrator Authentication (Use a strong random 32+ character string)
ADMIN_JWT_SECRET=your_secure_random_jwt_secret_here

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=

# Allowed Frontend Origins for CORS (Comma-separated)
# Include your Render frontend URL and the Vercel Verification Portal
FRONTEND_ORIGIN=https://c2c-verification-portal.vercel.app,https://code2conquer-document-generator.onrender.com,http://localhost:5173

# Public Certificate Verification Portal URL (Already deployed on Vercel)
PUBLIC_VERIFY_BASE_URL=https://c2c-verification-portal.vercel.app
